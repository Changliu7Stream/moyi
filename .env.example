# 墨忆 — 环境变量
# 复制为 .env.local（本地）/ 交给 Docker 挂载目录 / 配在 Vercel 项目环境变量里。
#
# ⚠️ 真实凭据绝不提交进仓库，也不要写进 Dockerfile 或 compose 的 environment。
#    本文件只列变量名与示例值，示例值一律是不可用的占位符。
#    任何进过公开仓库、前端包或镜像层的 key 都应视为已泄露，必须轮换。

# ══════════════════════════════════════════════════
# 第 1 组 · 存储后端（必填其一）
# ══════════════════════════════════════════════════
# 墨忆只依赖 PostgREST 协议，所以后端可换：
#   postgrest（默认）= 自托管原生 PostgreSQL + PostgREST，搭配 sql/00-schema.sql
#   supabase        = Supabase 托管，搭配 sql/vector-search.sql（会开 RLS）
# 未设置 MOYI_DB_BACKEND 时，按 URL 主机名推断（*.supabase.co → supabase）。
MOYI_DB_BACKEND=postgrest

# 自托管：填 PostgREST 的基址，通常是 http://<host>:3000（挂在根路径，无 /rest/v1）
MOYI_DB_URL=http://127.0.0.1:3000
# 自托管：PostgREST 的匿名 JWT（**不是**数据库密码）。用 MOYI_JWT_SECRET 签发：
#   MOYI_JWT_SECRET=xxx node scripts/gen-jwt.js
# 未给 PostgREST 配 PGRST_JWT_SECRET 时，这里填任意非空串即可（会被忽略）。
# 用非 JWT 形态的占位符，是为了不让密钥扫描工具误报成真实凭据。
MOYI_DB_TOKEN=replace-with-signed-jwt-or-any-nonempty-string

# Supabase 路线继续接受旧变量名，便于既有部署平移：
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=your-service-role-key      # 仅服务端，绝不下发浏览器

# 路径前缀。留空则自动推断（*.supabase.co → /rest/v1，其余 → 空前缀）。
# 只在反向代理额外加了前缀时才需要显式设置。
# MOYI_DB_PREFIX=

# ══════════════════════════════════════════════════
# 第 2 组 · 自托管 PostgREST 所需（仅 local 栈需要）
# ══════════════════════════════════════════════════
# 必须换成你自己的长随机串：compose 里它同时用作 psql 口令（POSTGRES_PASSWORD）
# 与 PostgREST 连接串里的密码。不设则 compose 启动失败（这是有意的：
# 宁可起不来，也不要带着默认口令上线）。
MOYI_PG_PASSWORD=
# JWT 签名密钥，仅当你打开 PGRST_JWT_SECRET 时才需要：
#   MOYI_JWT_SECRET=xxx node scripts/gen-jwt.js
MOYI_JWT_SECRET=
# JWT 有效期，默认 1 小时；PostgREST 匿名连接的角色名
MOYI_JWT_EXP_SECONDS=3600
PGRST_DB_ANON_ROLE=web_anon
# 墨忆容器映射到宿主机的端口（与本机其他服务冲突时改它）
MOYI_HOST_PORT=3906

# ══════════════════════════════════════════════════
# 第 3 组 · 掌柜口令
# ══════════════════════════════════════════════════
# 注册时带上此口令即可获得 master 角色，用于管理其他 Agent、回填向量、查审计。
# 不设则任何人都无法成为 master（安全默认）。
# MOYI_CODE 与 MASTER_CODE 等价，二者取其一即可。
MOYI_CODE=change-me-to-a-long-random-string

# ══════════════════════════════════════════════════
# 第 4 组 · embedding provider（可选）
# ══════════════════════════════════════════════════
# 不配置时使用内置的本地特征哈希向量（零依赖、离线可用，
# 但语义能力有限，「换个说法」的召回明显弱于真实模型）。
# 支持任何 OpenAI 兼容的 /v1/embeddings 接口，BGE 系列尤其中文效果好：
#   硅基流动      https://api.siliconflow.cn/v1/embeddings   BAAI/bge-large-zh-v1.5
#   硅基流动      https://api.siliconflow.cn/v1/embeddings   BAAI/bge-m3
#   OpenAI       https://api.openai.com/v1/embeddings      text-embedding-3-small
#   本地 Ollama  http://127.0.0.1:11434/v1/embeddings      nomic-embed-text
# ⚠️ MOYI_EMBED_DIM 必须等于 provider 模型的输出维度，并且与数据库里
#    memories.embedding 列的 vector(<dim>) 一致（见 sql/*.sql 的「维度常量」）。
#    常见维度：bge-small=384、bge-base=768、bge-large / bge-m3=1024。
# ⚠️ 大多数 BGE / 自建部署不接受请求里的 dimensions 参数，保持
#    MOYI_EMBED_SEND_DIM 为空即可；OpenAI text-embedding-3 若要截断维度设 1。
# ⚠️ 切换 provider 或维度后，旧向量与新向量不在同一空间，必须：
#    1) 用新维度重建 embedding 列；2) POST /api/admin/backfill-embeddings 全量回填。
MOYI_EMBED_URL=
MOYI_EMBED_KEY=
MOYI_EMBED_MODEL=text-embedding-3-small
MOYI_EMBED_DIM=384
MOYI_EMBED_SEND_DIM=

# ══════════════════════════════════════════════════
# 第 5 组 · 检索
# ══════════════════════════════════════════════════
# 混合检索权重：语义分 / 字面分
MOYI_W_VEC=0.7
MOYI_W_KW=0.3
# 服务层扫描的记忆条数上限（仅 scan 模式有意义）
MOYI_SCAN_LIMIT=1000
# 检索下推到数据库：1 = 走 match_memories() + pgvector HNSW；0 = 服务层暴力扫描。
# 前提是已执行迁移 SQL 建出 match_memories，且记忆已回填 embedding。
# RPC 不存在时会自动退回 scan，并在响应的 search_backend 字段里如实标注。
MOYI_DB_SEARCH=0
# DB 端召回的最低相似度门槛
MOYI_DB_MIN_SIM=0.05

# ══════════════════════════════════════════════════
# 第 6 组 · 语义去重阈值
# ══════════════════════════════════════════════════
# 默认值已用 test/dedupe-calibration.js 的实测样本校准，非必要不要改。
MOYI_DEDUPE_VEC=0.90
MOYI_DEDUPE_VEC_LOCAL=0.70
MOYI_DEDUPE_LEX=0.88
MOYI_DEDUPE_LEX_PROVIDER=0.60

# ══════════════════════════════════════════════════
# 第 7 组 · 记忆衰减与遗忘
# ══════════════════════════════════════════════════
# 活力 = exp(-(年龄天 / (1+访问次数)) / 半衰期)，再按重要性取地板。
# 半衰期（天）。调小 = 忘得快。
MOYI_DECAY_HALFLIFE=90
# 衰减总开关：设为 0 完全关闭（检索排序不再受时效影响）
MOYI_DECAY=1
# 低于此天数不进入遗忘候选；遗忘只对 low 生效，且永不自动执行
MOYI_FORGET_AFTER_DAYS=180
MOYI_FORGET_MAX_ACCESS=1

# ══════════════════════════════════════════════════
# 第 8 组 · 图谱
# ══════════════════════════════════════════════════
MOYI_GRAPH_MAX_DEG=8

# ══════════════════════════════════════════════════
# 第 9 组 · 限速与审计
# ══════════════════════════════════════════════════
# 注册接口是公开的（领钥匙就要用），只能限速不能关。
MOYI_REGISTER_PER_HOUR=10
MOYI_REGISTER_PER_DAY=30
# 认证**失败**次数上限（成功不计入，所以正常用户不会把自己限掉）
MOYI_AUTH_FAIL_PER_15MIN=30
# 审计事件环形缓冲条数
MOYI_AUDIT_CAPACITY=2000

# ══════════════════════════════════════════════════
# 第 10 组 · 管理台（引导安装页 / 管理员会话）
# ══════════════════════════════════════════════════
# 管理台在 /console，API 在 /api/console/*。第一个管理员由引导安装页立，
# 装完即永久封存；口令以 scrypt 哈希入库，服务端无法还原。
# 注意：数据库连接信息**不能**在网页里填，只能在第 1 组的环境变量里配 ——
# 否则任何一次 XSS 都具备换后端的能力。
# 管理员会话有效期（天）。代码里钳制在 1 分钟 ~ 30 天之间，写 999 也只按 30 天算；
# 改口令或被停用会立刻作废全部会话。
MOYI_SESSION_DAYS=7
# 管理台口令暴破限速（每来源 / 15 分钟）。与 Agent Key 的
# MOYI_AUTH_FAIL_PER_15MIN 是两套独立计数器：一方试错不该把另一方锁在门外。
MOYI_ADMIN_FAIL_PER_15MIN=10
# 实例设置（全局记忆、开放注册）的进程内缓存毫秒数。
# 多实例部署下这是「改了设置到全实例生效」的延迟；同进程内的写入会立即失效缓存。
# 设 0 表示每次都读库（最准，代价是每个请求多一次 settings 查询）。
MOYI_SETTINGS_TTL_MS=5000

# ══════════════════════════════════════════════════
# 第 11 组 · 网络
# ══════════════════════════════════════════════════
# 允许跨域访问 API 的前端来源，逗号分隔。
# 默认只放行同源与 localhost:3906；设为 * 会重新引入 CSRF 风险。
MOYI_ALLOWED_ORIGINS=http://localhost:3906
MOYI_PORT=3906
MOYI_HOST=0.0.0.0
